import { initializeApp } from 'firebase/app';
import { 
  getFirestore, 
  collection, 
  doc, 
  setDoc, 
  getDoc, 
  addDoc, 
  onSnapshot 
} from 'firebase/firestore';

class BeastTVStreamEngine {
  constructor(firebaseConfig) {
    this.app = initializeApp(firebaseConfig);
    this.db = getFirestore(this.app);
    this.peerConnection = null;
    this.dataChannel = null;
    this.remoteStream = new MediaStream();
    this.iceConfig = {
      iceServers: [
        { urls: 'stun:stun.l.google.com:19302' },
        { urls: 'stun:stun1.l.google.com:19302' }
      ]
    };
  }

  async startBroadcast(sessionId, localStream, onDataMessage) {
    this.peerConnection = new RTCPeerConnection(this.iceConfig);
    localStream.getTracks().forEach((track) => this.peerConnection.addTrack(track, localStream));

    this.dataChannel = this.peerConnection.createDataChannel('btv-controller', {
      ordered: false,
      maxRetransmits: 0
    });
    this.setupDataChannel(onDataMessage);

    const sessionRef = doc(this.db, 'btv_sessions', sessionId);
    const offerCandidates = collection(sessionRef, 'offerCandidates');

    this.peerConnection.onicecandidate = (event) => {
      if (event.candidate) addDoc(offerCandidates, event.candidate.toJSON());
    };

    const offerDescription = await this.peerConnection.createOffer();
    await this.peerConnection.setLocalDescription(offerDescription);
    await setDoc(sessionRef, { offer: { sdp: offerDescription.sdp, type: offerDescription.type } });

    onSnapshot(sessionRef, (snapshot) => {
      const data = snapshot.data();
      if (!this.peerConnection.currentRemoteDescription && data?.answer) {
        this.peerConnection.setRemoteDescription(new RTCSessionDescription(data.answer));
      }
    });

    onSnapshot(collection(sessionRef, 'answerCandidates'), (snapshot) => {
      snapshot.docChanges().forEach((change) => {
        if (change.type === 'added') {
          this.peerConnection.addIceCandidate(new RTCIceCandidate(change.doc.data()));
        }
      });
    });
  }

  async joinStream(sessionId, onStreamReady, onDataMessage) {
    this.peerConnection = new RTCPeerConnection(this.iceConfig);

    this.peerConnection.ontrack = (event) => {
      event.streams[0].getTracks().forEach((track) => this.remoteStream.addTrack(track));
      onStreamReady(this.remoteStream);
    };

    this.peerConnection.ondatachannel = (event) => {
      this.dataChannel = event.channel;
      this.setupDataChannel(onDataMessage);
    };

    const sessionRef = doc(this.db, 'btv_sessions', sessionId);
    const answerCandidates = collection(sessionRef, 'answerCandidates');

    this.peerConnection.onicecandidate = (event) => {
      if (event.candidate) addDoc(answerCandidates, event.candidate.toJSON());
    };

    const sessionSnap = await getDoc(sessionRef);
    const sessionData = sessionSnap.data();
    await this.peerConnection.setRemoteDescription(new RTCSessionDescription(sessionData.offer));

    const answerDescription = await this.peerConnection.createAnswer();
    await this.peerConnection.setLocalDescription(answerDescription);
    await setDoc(sessionRef, { answer: { sdp: answerDescription.sdp, type: answerDescription.type } }, { merge: true });

    onSnapshot(collection(sessionRef, 'offerCandidates'), (snapshot) => {
      snapshot.docChanges().forEach((change) => {
        if (change.type === 'added') {
          this.peerConnection.addIceCandidate(new RTCIceCandidate(change.doc.data()));
        }
      });
    });
  }

  setupDataChannel(onMessageCallback) {
    this.dataChannel.binaryType = 'arraybuffer';
    this.dataChannel.onmessage = (event) => onMessageCallback?.(event.data);
  }

  sendInput(data) {
    if (this.dataChannel?.readyState === 'open') {
      this.dataChannel.send(data);
    }
  }
}

export default BeastTVStreamEngine;

