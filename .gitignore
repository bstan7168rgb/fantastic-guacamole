import re
from datetime import datetime, timezone
from typing import Dict, List, Literal, Optional
from pydantic import BaseModel, Field


class DocumentMetadata(BaseModel):
    title: str
    author: str
    version: str
    semantic_tags: List[str]
    authority_level: Literal["canonical", "working_draft", "deprecated", "ephemeral"]
    access_scope: Literal["internal_agent", "cross_developer", "public_runtime"]
    estimated_tokens: int = 0


class DocumentContent(BaseModel):
    raw: str
    sanitized_markdown: str = ""
    ast_summary: str = ""
    extracted_entities: List[str] = Field(default_factory=list)


class PlatformProfiles(BaseModel):
    mcp_resource: bool = True
    gemini_context: bool = True
    claude_projects: bool = True
    local_agent_runtime: bool = True


class CanonicalContextRecord(BaseModel):
    context_id: str
    source_id: str
    origin_uri: str
    mime_type: str
    extracted_at: str
    metadata: DocumentMetadata
    content: DocumentContent
    target_platform_profiles: PlatformProfiles


class ContextFilterPipeline:
    SECRET_PATTERNS = [
        re.compile(r"sk-[a-zA-Z0-9_-]{24,64}"),
        re.compile(r"ghp_[a-zA-Z0-9]{36}"),
        re.compile(r"-----BEGIN (?:RSA )?PRIVATE KEY-----[\s\S]*?-----END (?:RSA )?PRIVATE KEY-----"),
        re.compile(r"bearer\s+[a-zA-Z0-9\._-]{20,}", re.IGNORECASE),
    ]

    def __init__(self, max_token_budget: int = 4000):
        self.max_token_budget = max_token_budget

    def _estimate_tokens(self, text: str) -> int:
        return max(1, len(text) // 4)

    def filter_hygiene(self, text: str) -> str:
        text = text.replace("\x00", "").replace("\r\n", "\n")
        text = re.sub(r"\n{3,}", "\n\n", text)
        return text.strip()

    def filter_redaction(self, text: str) -> str:
        scrubbed = text
        for pattern in self.SECRET_PATTERNS:
            scrubbed = pattern.sub("[REDACTED_SECRET]", scrubbed)
        return scrubbed

    def filter_structural_budget(self, text: str, mime_type: str) -> str:
        current_tokens = self._estimate_tokens(text)
        if current_tokens <= self.max_token_budget:
            return text

        char_limit = self.max_token_budget * 4
        truncated_body = text[:char_limit]

        if mime_type in ["text/x-python", "text/x-typescript"]:
            symbols = re.findall(r"(?:class|def|function|interface|type)\s+([a-zA-Z0-9_]+)", text)
            symbol_index = "\n".join(f"- `{sym}`" for sym in symbols[:40])
            return (
                f"{truncated_body}\n\n"
                f"<!-- Context truncated at token budget: {self.max_token_budget} -->\n"
                f"### Detected Symbols\n{symbol_index}"
            )

        return f"{truncated_body}\n\n<!-- Truncated to fit platform token budget -->"

    def process(
        self,
        raw_content: str,
        origin_uri: str,
        mime_type: str,
        title: str,
        author: str,
        semantic_tags: List[str],
        authority: Literal["canonical", "working_draft", "deprecated", "ephemeral"],
        scope: Literal["internal_agent", "cross_developer", "public_runtime"]
    ) -> CanonicalContextRecord:
        clean_text = self.filter_hygiene(raw_content)
        sanitized_text = self.filter_redaction(clean_text)
        budgeted_text = self.filter_structural_budget(sanitized_text, mime_type)
        
        hasher = hashlib.sha256()
        hasher.update(origin_uri.encode("utf-8"))
        source_id = hasher.hexdigest()[:16]

        uuid_seed = hashlib.md5(f"{origin_uri}:{datetime.now(timezone.utc).isoformat()}".encode("utf-8")).hexdigest()
        context_id = f"{uuid_seed[:8]}-{uuid_seed[8:12]}-{uuid_seed[12:16]}-{uuid_seed[16:20]}-{uuid_seed[20:32]}"

        metadata = DocumentMetadata(
            title=title,
            author=author,
            version="1.0.0",
            semantic_tags=semantic_tags,
            authority_level=authority,
            access_scope=scope,
            estimated_tokens=self._estimate_tokens(budgeted_text)
        )

        content = DocumentContent(
            raw=raw_content,
            sanitized_markdown=budgeted_text,
            ast_summary=f"Processed {len(budgeted_text)} chars from {origin_uri}",
            extracted_entities=re.findall(r"\b[A-Z][a-zA-Z0-9_]{3,}\b", budgeted_text)[:15]
        )

        return CanonicalContextRecord(
            context_id=context_id,
            source_id=source_id,
            origin_uri=origin_uri,
            mime_type=mime_type,
            extracted_at=datetime.now(timezone.utc).isoformat(),
            metadata=metadata,
            content=content,
            target_platform_profiles=PlatformProfiles()
        )

    def export_for_mcp(self, record: CanonicalContextRecord) -> Dict[str, object]:
        """Serializes record to Model Context Protocol Resource Read format."""
        return {
            "uri": f"context://workspace/{record.source_id}",
            "name": record.metadata.title,
            "mimeType": "text/markdown",
            "text": f"# {record.metadata.title}\n"
                    f"**Authority:** {record.metadata.authority_level} | **Source:** {record.origin_uri}\n\n"
                    f"{record.content.sanitized_markdown}"
        }

    def export_for_gemini(self, record: CanonicalContextRecord) -> Dict[str, object]:
        """Serializes record as an explicit system context dictionary block."""
        return {
            "role": "user",
            "parts": [
                {
                    "text": f"Context Document: {record.metadata.title}\n"
                            f"Tags: {', '.join(record.metadata.semantic_tags)}\n"
                            f"Body:\n{record.content.sanitized_markdown}"
                }
            ]
        }
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrossPlatformContextPayload",
  "type": "object",
  "required": [
    "context_id",
    "source_id",
    "origin_uri",
    "mime_type",
    "extracted_at",
    "content",
    "metadata",
    "target_platform_profiles"
  ],
  "properties": {
    "context_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_id": {
      "type": "string",
      "description": "Deterministic hash of original file URI or workspace asset identifier"
    },
    "origin_uri": {
      "type": "string",
      "format": "uri"
    },
    "mime_type": {
      "type": "string",
      "enum": [
        "text/plain",
        "text/markdown",
        "text/x-python",
        "text/x-typescript",
        "application/json",
        "application/pdf"
      ]
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "required": ["semantic_tags", "authority_level", "access_scope", "estimated_tokens"],
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string" },
        "semantic_tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "authority_level": {
          "type": "string",
          "enum": ["canonical", "working_draft", "deprecated", "ephemeral"]
        },
        "access_scope": {
          "type": "string",
          "enum": ["internal_agent", "cross_developer", "public_runtime"]
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "content": {
      "type": "object",
      "required": ["raw", "sanitized_markdown", "ast_summary"],
      "properties": {
        "raw": { "type": "string" },
        "sanitized_markdown": { "type": "string" },
        "ast_summary": { "type": "string" },
        "extracted_entities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "target_platform_profiles": {
      "type": "object",
      "properties": {
        "mcp_resource": { "type": "boolean", "default": true },
        "gemini_context": { "type": "boolean", "default": true },
        "claude_projects": { "type": "boolean", "default": true },
        "local_agent_runtime": { "type": "boolean", "default": true }
      }
    }
  }
}
